# Copy locally to .env only with your own values; npm start does not load .env automatically.
# On Render, enter secret values yourself in the secure environment settings.
NODE_ENV=production
PORT=3201
JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ALLOWED_ORIGINS=
EXTERNAL_INTEGRATIONS_ENABLED=false
CARD_PAYMENTS_ENABLED=false
# Must be inside the configured persistent disk mount on Render:
DATA_DIR=/var/data/hotel-panama-canal
